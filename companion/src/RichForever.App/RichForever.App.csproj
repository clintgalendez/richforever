<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>RichForever</AssemblyName>
    <RootNamespace>RichForever.App</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>richforever.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Application.SetColorMode is marked experimental. -->
    <NoWarn>$(NoWarn);WFO5001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="richforever.ico" LogicalName="RichForever.App.richforever.ico" />
    <ProjectReference Include="..\RichForever.Core\RichForever.Core.csproj" />
    <InternalsVisibleTo Include="RichForever.Tests" />
  </ItemGroup>

</Project>
